meta {
  name: 07 Metodo nao permitido 405
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/
  body: none
  auth: none
}

tests {
  test("POST na raiz devolve 405 e preserva os métodos permitidos", function () {
    expect(res.getStatus()).to.equal(405);
    expect(res.getBody()).to.have.property("erro");
    expect(res.getHeader("Allow")).to.include("GET");
  });
}
